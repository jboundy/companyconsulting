{
  "runtime": "Net100",
  "documentGenerators": {
    "aspNetCoreToOpenApi": {
      "assemblyPaths": ["bin/Debug/net10.0/Billing.Web.Api.dll"],
      "referencePaths": [],
      "useNuGetCache": true,
      "output": "swagger.json"
    }
  },
  "codeGenerators": {
    "openApiToTypeScriptClient": {
      "className": "{controller}Client",
      "moduleName": "",
      "namespace": "",
      "typeScriptVersion": 4.3,
      "template": "Axios",
      "promiseType": "Promise",
      "httpClass": "Http",
      "withCredentials": false,
      "output": "../../../ui/billing-ui/src/api/apiClient.ts"
    }
  }
}
