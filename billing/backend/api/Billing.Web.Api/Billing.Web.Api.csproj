<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>aspnet-Billing.Web.Api-5e7d8baa-d554-428b-8351-fa7ce8ca0546</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FastEndpoints" Version="8.3.0" />
    <PackageReference Include="FastEndpoints.Swagger" Version="8.3.0" />
    <PackageReference Include="Marten" Version="9.44.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" NoWarn="NU1605" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.12" NoWarn="NU1605" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="WolverineFx" Version="6.44.0" />
    <PackageReference Include="WolverineFx.Http.Marten" Version="6.44.0" />
    <PackageReference Include="WolverineFx.Marten" Version="6.44.0" />
    <PackageReference Include="WolverineFx.RuntimeCompilation" Version="6.44.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\domain\Billing.Domain.BusinessLogic\Billing.Domain.BusinessLogic.csproj" />
    <ProjectReference Include="..\..\domain\Billing.Domain.Models\Billing.Domain.Models.csproj" />
    <ProjectReference Include="..\..\domain\Billing.Domain.ServiceWrapper\Billing.Domain.ServiceWrapper.csproj" />
  </ItemGroup>

<Target Name="NSwag" AfterTargets="PostBuildEvent">
    <Exec Command="nswag run nswag.json" />
  </Target>
</Project>
