{
  "runtime": "Net100",
  "defaultVariables": "Configuration=Debug",
  "documentGenerators": {
    "aspNetCoreToOpenApi": {
      "project": "Product.Web.Api.csproj",
      "noBuild": true,
      "aspNetCoreEnvironment": "Development",
      "output": "swagger.json"
    }
  },
  "codeGenerators": {
    "openApiToTypeScriptClient": {
      "input": "swagger.json",
      "className": "{controller}Client",
      "moduleName": "",
      "namespace": "",
      "typeScriptVersion": 4.3,
      "template": "Axios",
      "promiseType": "Promise",
      "httpClass": "Http",
      "withCredentials": false,
      "output": "../../../ui/product-ui/src/api/apiClient.ts"
    }
  }
}
